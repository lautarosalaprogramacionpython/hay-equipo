rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedPhone() {
      return signedIn() && request.auth.token.phone_number is string;
    }

    function isTeamMember(teamId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    function isMatchMember(matchId) {
      let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return signedIn()
        && (isTeamMember(matchData.teamIds[0]) || isTeamMember(matchData.teamIds[1]));
    }

    function isOpponentTeamMember(matchId) {
      let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/teams/$(matchData.teamIds[1])
        ).data.members;
    }

    function validChatMessage(roomPath, messageId) {
      let data = request.resource.data;
      let commonFields = ['senderId', 'senderName', 'text', 'createdAt'];
      let messageFields = [
        'senderId', 'senderName', 'text', 'createdAt', 'type',
        'mediaUrl', 'storagePath', 'mediaName', 'mimeType', 'durationMs'
      ];
      let textMessage = (
        (
          (!('type' in data) && data.keys().hasOnly(commonFields))
          || (data.type == 'text'
            && data.keys().hasOnly(commonFields.concat(['type'])))
        )
        && data.text.size() > 0
      );
      let mediaMessage = (
        data.type in ['image', 'gif', 'video', 'audio']
        && data.keys().hasOnly(messageFields)
        && data.text.size() <= 4000
        && data.mediaUrl is string
        && data.mediaUrl.size() <= 2048
        && data.storagePath is string
        && data.storagePath.matches(
          '^' + roomPath + '/messages/' + messageId + '/'
            + request.auth.uid + '/[^/]+$'
        )
        && data.mediaName is string
        && data.mediaName.size() <= 128
        && data.mimeType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif',
          'image/gif', 'video/mp4', 'video/x-m4v', 'video/quicktime',
          'video/webm', 'audio/mp4', 'audio/aac', 'audio/wav', 'audio/mpeg',
          'audio/ogg', 'audio/webm'
        ]
        && (
          (data.type == 'image' && data.mimeType in [
            'image/jpeg', 'image/png', 'image/webp', 'image/heic', 'image/heif'
          ])
          || (data.type == 'gif' && data.mimeType == 'image/gif')
          || (data.type == 'video' && data.mimeType in [
            'video/mp4', 'video/x-m4v', 'video/quicktime', 'video/webm'
          ])
          || (data.type == 'audio'
            && data.mimeType in [
              'audio/mp4', 'audio/aac', 'audio/wav', 'audio/mpeg',
              'audio/ogg', 'audio/webm'
            ]
            && data.durationMs is int
            && data.durationMs >= 500
            && data.durationMs <= 120000)
        )
      );
      return signedIn()
        && data.senderId == request.auth.uid
        && data.senderName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && data.text is string
        && data.text.size() <= 4000
        && data.createdAt is timestamp
        && (textMessage || mediaMessage);
    }

    function acceptsTeamInvitation(teamId) {
      let invitation = getAfter(
        /databases/$(database)/documents/teams/$(teamId)/invitations/$(request.auth.uid)
      ).data;
      return signedIn()
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && invitation.playerId == request.auth.uid
        && invitation.status == 'accepted';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if verifiedPhone()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && getAfter(/databases/$(database)/documents/users/$(uid)/private/profile).data.phone
          == request.auth.token.phone_number
        && getAfter(/databases/$(database)/documents/phoneNumbers/$(request.auth.token.phone_number)).data.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;

      match /private/{profileId} {
        allow read: if signedIn() && request.auth.uid == uid && profileId == 'profile';
        allow create: if verifiedPhone()
          && request.auth.uid == uid
          && profileId == 'profile'
          && request.resource.data.phone == request.auth.token.phone_number
          && request.resource.data.email is string
          && request.resource.data.keys().hasOnly(['email', 'phone']);
        allow update: if signedIn()
          && request.auth.uid == uid
          && profileId == 'profile'
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
        allow delete: if false;
      }

      match /reportLimits/{day} {
        allow read, write: if false;
      }
    }

    match /phoneNumbers/{phone} {
      allow read: if verifiedPhone() && request.auth.token.phone_number == phone;
      allow create: if verifiedPhone()
        && request.auth.token.phone_number == phone
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/phoneNumbers/$(phone));
      allow update, delete: if false;
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.courtType in [5, 7];
      allow update: if signedIn()
        && (
          (resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'courtType', 'description', 'color', 'members']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && acceptsTeamInvitation(teamId))
        );
      allow delete: if false;

      match /requests/{playerId} {
        allow read: if isTeamMember(teamId);
        allow create: if signedIn()
          && request.auth.uid == playerId
          && request.resource.data.uid == playerId
          && request.resource.data.status == 'pending'
          && !isTeamMember(teamId);
        allow update: if isTeamMember(teamId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      match /invitations/{playerId} {
        allow read: if isTeamMember(teamId) || (signedIn() && request.auth.uid == playerId);
        allow create: if isTeamMember(teamId)
          && request.resource.data.playerId == playerId
          && request.resource.data.playerId != request.auth.uid
          && request.resource.data.status == 'pending'
          && !(playerId in get(/databases/$(database)/documents/teams/$(teamId)).data.members);
        allow update: if signedIn()
          && request.auth.uid == playerId
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isTeamMember(teamId);
        allow create: if isTeamMember(teamId)
          && validChatMessage('teams/' + teamId, messageId);
        allow update, delete: if false;
      }
    }

    match /{path=**}/invitations/{playerId} {
      allow read: if signedIn() && resource.data.playerId == request.auth.uid;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.kind == 'direct'
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && validChatMessage('chats/' + chatId, messageId);
        allow update, delete: if false;
      }
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.teamIds is list
        && request.resource.data.teamIds.size() == 2
        && request.resource.data.teamIds[0] != request.resource.data.teamIds[1]
        && isTeamMember(request.resource.data.teamIds[0])
        && request.resource.data.courtType in [5, 7]
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
          resource.data.status == 'proposed'
          && isOpponentTeamMember(matchId)
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        ) || (
          resource.data.status == 'accepted'
          && isMatchMember(matchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['scheduledAt', 'location'])
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchMember(matchId);
        allow create: if isMatchMember(matchId)
          && validChatMessage('matches/' + matchId, messageId);
        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid;
      allow write: if false;
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
